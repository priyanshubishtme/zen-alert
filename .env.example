# ── Backend (Render) ─────────────────────────────────────────
# Comma-separated list of allowed frontend origins for CORS.
# Set this to your Vercel deployment URL(s).
# Example: https://zen-alert.vercel.app,https://yourdomain.com
FRONTEND_ORIGINS=

# ── Frontend (Vercel / local dev) ────────────────────────────
# Not used at runtime. The API base URL is configured in:
#   frontend/js/api.js  →  PRODUCTION_API_URL constant
# OR via an inline <script> tag setting window.ZENALERT_API_BASE
